# .env.example — copier en .env et renseigner. NE JAMAIS committer .env.
#
# Ces clés ne concernent QUE les sources internationales. Les 7 sources
# francophones (HAL, Isidore, OpenEdition, Cairn, Persée, Theses.fr, Érudit)
# fonctionnent sans aucune clé.
#
# Le fichier .env est chargé automatiquement par utils/secrets.py si
# python-dotenv est installé (extra : pip install "moisson-shs[dotenv]").
# Sinon, exporter ces variables dans le shell ou, pour le MCP, les renseigner
# dans le bloc "env" de claude_desktop_config.json (voir MCP_INSTALL.md).

# OpenAlex — REQUIS (clé gratuite). https://openalex.org/settings/api
OPENALEX_API_KEY=

# Semantic Scholar — OPTIONNEL (sans clé : pool partagé throttlé).
# https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# CORE — REQUIS (sur inscription ; validation parfois différée).
# https://core.ac.uk/services/api
CORE_API_KEY=

# Contact déclaré dans les User-Agent (polite pool CrossRef / identification
# OpenAlex). Optionnel : une valeur par défaut existe dans config.py.
# MOISSON_CONTACT_EMAIL=vous@example.org


# ============================================================================
# Serveur MCP DISTANT (mode HTTP — `moisson-shs serve --http`)
# ----------------------------------------------------------------------------
# Ces variables ne concernent QUE le mode serveur distant. Inutiles en stdio
# (Claude Desktop local). Voir REMOTE.md pour le déploiement complet.
# ============================================================================

# Jeton Bearer attendu — OBLIGATOIRE en HTTP (sans lui, refus de démarrer).
# Générer : python -c "import secrets; print(secrets.token_urlsafe(32))"
# MOISSON_API_TOKEN=

# Jetons additionnels valides (rotation sans coupure), séparés par virgules.
# MOISSON_API_TOKENS=

# Base HTTPS publique pour fabriquer les URLs de téléchargement (Sprint 08).
# MOISSON_PUBLIC_BASE_URL=https://moisson.example.org

# Interface / port uvicorn (en Docker derrière proxy : 0.0.0.0, jamais publié).
# MOISSON_HTTP_HOST=127.0.0.1
# MOISSON_HTTP_PORT=8000

# Allowlist Host (anti DNS-rebinding) — OBLIGATOIRE si bind non-loopback.
# MOISSON_ALLOWED_HOSTS=moisson.example.org

# Durcissement (optionnels) : taille max de corps (413), rate-limit/min (429).
# MOISSON_HTTP_MAX_BODY=1000000
# MOISSON_RATE_LIMIT=

# --- OAuth 2.1 (connecteur claude.ai web) ---
# claude.ai (web) n'accepte QUE OAuth (pas le Bearer statique). Activer pour
# exposer authorize/token/register/metadata EN PLUS du Bearer (qui reste valable
# pour Claude Desktop/Code). Nécessite MOISSON_PUBLIC_BASE_URL.
# MOISSON_OAUTH_ENABLED=1
# Mot de passe de la page de consentement OAuth (OBLIGATOIRE si OAuth activé).
# MOISSON_OAUTH_PASSWORD=

# Anti-DoS moisson (optionnels) : plafond items/source, concurrence, deadline.
# MOISSON_MAX_ITEMS_PER_SOURCE=3000
# MOISSON_MAX_CONCURRENT=2
# MOISSON_DEADLINE_SECONDS=900

# --- Déploiement Docker + Caddy (TLS) — consommés par docker-compose/Caddyfile ---
# Domaine public pointant vers le VPS (A/AAAA), pour le certificat Let's Encrypt.
# MOISSON_DOMAIN=moisson.example.org
# E-mail du compte ACME (notifications d'expiration de certificat).
# ACME_EMAIL=vous@example.org
